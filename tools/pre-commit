#!/bin/sh
# Git pre-commit hook: refuse the commit if customer data is staged.
# Install once:  cp tools/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0
# shellcheck disable=SC2086
python3 tools/check_no_customer_data.py $staged
